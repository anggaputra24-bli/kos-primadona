{
  "name": "kos-primadona",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "dev:hp": "concurrently -k \"npm run server\" \"npm run client -- --host\"",
    "client": "vite frontend --config frontend/vite.config.mjs",
    "server": "node backend/index.js",
    "build": "vite build frontend --config frontend/vite.config.mjs",
    "start": "node backend/index.js",
    "test": "node --test tests/api/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "data:ekspor": "node scripts/data-online.js ekspor",
    "data:impor": "node scripts/data-online.js impor"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22"
  }
}
