{
  "name": "kos-primadona",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "client": "vite frontend --config frontend/vite.config.mjs",
    "server": "node backend/index.js",
    "build": "vite build frontend --config frontend/vite.config.mjs",
    "start": "node backend/index.js",
    "test": "node --test tests/api/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "exceljs": "^4.4.0",
    "express": "latest",
    "jsonwebtoken": "latest",
    "multer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "latest"
  }
}
