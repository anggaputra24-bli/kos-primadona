# Salin file ini menjadi .env lalu isi dengan nilai rahasia Anda sendiri.
# Jangan pernah menyimpan nilai asli di file ini.

# Kode rahasia untuk membuka halaman login admin (Ctrl+Z). Minimal 16 karakter.
ADMIN_ACCESS_CODE=ganti-dengan-kode-rahasia-anda

# Kunci penanda sesi login. Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter

# Port server backend (opsional)
# PORT=3001
